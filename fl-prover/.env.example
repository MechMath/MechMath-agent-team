# Path to the KB-Manager knowledge base repository
KB_MANAGER_DIR=/path/to/KB-Manager
DATA_DIR=/path/to/data

# API keys
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=...

# Lean-specific search backends
LEANDEX_API_KEY=...

# Lean toolchain — only needed when elan does not live in ~/.elan
LEAN_ELAN_HOME=/path/to/.elan
