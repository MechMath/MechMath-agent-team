prefix_rule(pattern=["rm"], decision="forbidden")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["file"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "-C", "..", "add", "data"], decision="allow")
prefix_rule(pattern=["git", "-C", "..", "commit", "-m"], decision="allow")
prefix_rule(pattern=["git", "-C", "..", "diff"], decision="allow")
prefix_rule(pattern=["git", "-C", "..", "log"], decision="allow")
prefix_rule(pattern=["git", "-C", "..", "show"], decision="allow")
prefix_rule(pattern=["git", "-C", "..", "status"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["cp", "-n"], decision="allow")
prefix_rule(pattern=["mkdir", "-p"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["sed", "-n"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["test", "-d"], decision="allow")
prefix_rule(pattern=["test", "-f"], decision="allow")
# The five model-facing tool facades (each groups its internal package).
prefix_rule(pattern=["uv", "run", "python", "cli_tools/memory.py"], decision="allow")
prefix_rule(pattern=["uv", "run", "python", "cli_tools/search.py"], decision="allow")
prefix_rule(pattern=["uv", "run", "python", "cli_tools/external.py"], decision="allow")
prefix_rule(pattern=["uv", "run", "python", "cli_tools/gate.py"], decision="allow")
prefix_rule(pattern=["uv", "run", "python", "cli_tools/workspace.py"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
# Control plane + the Lean toolchain facade (FL-Prover).
prefix_rule(pattern=["uv", "run", "python", "cli_tools/control.py"], decision="allow")
prefix_rule(pattern=["uv", "run", "python", "cli_tools/lean.py"], decision="allow")
prefix_rule(pattern=["python", "cli_tools/control.py"], decision="allow")
prefix_rule(pattern=["python", "cli_tools/lean.py"], decision="allow")
prefix_rule(pattern=["cli_tools/leancheck.sh"], decision="allow")
